{
  "name": "@sonettogu14/dsh-te-cost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cache-weighted equivalent-token accounting for DSH sessions.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@sonettogu14/dsh-te-core": "workspace:*",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.2-rc.3 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/dsh-session": {
      "optional": false
    },
    "@deepseek-ai/dsh-llm": {
      "optional": false
    },
    "@deepseek-ai/dsh-commands": {
      "optional": false
    }
  }
}
