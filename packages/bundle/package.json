{
  "name": "dsh-te",
  "version": "0.3.0",
  "description": "Bundle that installs the cost, facts and prune components together. · 一次装齐成本记账、仓库事实与工具隐藏三个组件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "插件",
    "token",
    "cost",
    "cache",
    "context",
    "token-economizer",
    "成本",
    "缓存"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SonettoGu14/dsh-tokeneconomizer.git",
    "directory": "packages/bundle"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm -w run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-te-core": "workspace:*",
    "dsh-te-cost": "workspace:*",
    "dsh-te-facts": "workspace:*",
    "dsh-te-prune": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.3"
  },
  "homepage": "https://github.com/SonettoGu14/dsh-tokeneconomizer/tree/master/packages/bundle#readme",
  "bugs": {
    "url": "https://github.com/SonettoGu14/dsh-tokeneconomizer/issues"
  }
}
