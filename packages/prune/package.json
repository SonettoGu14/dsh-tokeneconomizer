    "@deepseek-ai/dsh": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.2-rc.3 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
